bongSlanhOun "raytracer";
// a small path tracer, ray tracing in one weekend style. writes a PPM:
//   ./build/steav examples/sts/raytracer.sts > out.ppm
yok vector;
yok math;
yok random jea rng;

sampoan Ray {
    akthe origin: Vec3;
    akthe dir: Vec3;
    rupamun at(t: LekThom) -> Vec3 { morvenh origin + dir * t; }
}

sampoan HitRecord {
    akthe p: Vec3;
    akthe normal: Vec3;
    akthe t: LekThom;
    akthe material: Material;
}

// kind: 0 = diffuse, 1 = metal, 2 = glass
tnak Material {
    akthe kind: LekKut;
    akthe albedo: Vec3;
    akthe param: LekThom; // metal: fuzz, glass: index of refraction

    rupamun init(kind: LekKut, albedo: Vec3, param: LekThom) {
        nis.kind = kind;
        nis.albedo = albedo;
        nis.param = param;
    }
}

sampoan Scatter {
    akthe ray: Ray;
    akthe attenuation: Vec3;
}

rupamun scatter(m: Material, r: Ray, h: HitRecord) -> Scatter? {
    ber (m.kind == 0) {
        akthe dir = h.normal + random_unit_vector();
        ber (dir.near_zero()) dir = h.normal;
        morvenh Scatter(Ray(h.p, dir), m.albedo);
    }
    ber (m.kind == 1) {
        akthe reflected = reflect(r.dir.normalized(), h.normal) + random_unit_vector() * m.param;
        ber (dot(reflected, h.normal) <= 0) morvenh sone;
        morvenh Scatter(Ray(h.p, reflected), m.albedo);
    }
    // glass
    akthe front = dot(r.dir, h.normal) < 0;
    akthe n = h.normal;
    akthe ratio = 1 / m.param;
    ber (!front) {
        n = -h.normal;
        ratio = m.param;
    }
    akthe unit = r.dir.normalized();
    akthe cos_theta = min(dot(-unit, n), 1);
    akthe sin_theta = sqrt(1 - cos_theta * cos_theta);
    akthe dir = refract(unit, n, ratio);
    ber (ratio * sin_theta > 1 reu schlick_approx(cos_theta, ratio) > rng.uniform()) {
        dir = reflect(unit, n);
    }
    morvenh Scatter(Ray(h.p, dir), one());
}

tnak Sphere {
    akthe center: Vec3;
    akthe radius: LekThom;
    akthe material: Material;

    rupamun init(center: Vec3, radius: LekThom, material: Material) {
        nis.center = center;
        nis.radius = radius;
        nis.material = material;
    }

    rupamun hit(r: Ray, t_min: LekThom, t_max: LekThom) -> HitRecord? {
        akthe oc = r.origin - center;
        akthe a = r.dir.length_sq();
        akthe half_b = dot(oc, r.dir);
        akthe c = oc.length_sq() - radius * radius;
        akthe disc = half_b * half_b - a * c;
        ber (disc < 0) morvenh sone;
        akthe sq = sqrt(disc);
        akthe root = (-half_b - sq) / a;
        ber (root < t_min reu root > t_max) {
            root = (-half_b + sq) / a;
            ber (root < t_min reu root > t_max) morvenh sone;
        }
        akthe p = r.at(root);
        morvenh HitRecord(p, (p - center) / radius, root, material);
    }
}

tnak Scene {
    akthe objects: [Sphere];
    rupamun init() { objects = []; }
    rupamun add(s: Sphere) { objects.push(s); }

    rupamun hit(r: Ray, t_min: LekThom, t_max: LekThom) -> HitRecord? {
        akthe closest: HitRecord? = sone;
        akthe best = t_max;
        somhab (akthe i: LekKut = 0; i < objects.len(); i = i + 1) {
            akthe h = objects[i].hit(r, t_min, best);
            ber (h != sone) {
                best = h.t;
                closest = h;
            }
        }
        morvenh closest;
    }
}

rupamun ray_color(r: Ray, scene: Scene, depth: LekKut) -> Vec3 {
    ber (depth <= 0) morvenh zero();
    akthe h = scene.hit(r, 0.001, INFINITY);
    ber (h != sone) {
        akthe s = scatter(h.material, r, h);
        ber (s != sone) {
            morvenh s.attenuation * ray_color(s.ray, scene, depth - 1);
        }
        morvenh zero();
    }
    akthe t = 0.5 * (r.dir.normalized().y + 1);
    morvenh lerp(one(), Vec3(0.5, 0.7, 1), t);
}

rupamun to_byte(c: LekThom) -> LekKut {
    // gamma 2
    morvenh LekKut(256 * clamp(sqrt(c), 0, 0.999));
}

akthe scene = Scene();
scene.add(Sphere(Vec3(0, -100.5, -1), 100, Material(0, Vec3(0.8, 0.8, 0), 0)));
scene.add(Sphere(Vec3(0, 0, -1.2), 0.5, Material(0, Vec3(0.1, 0.2, 0.5), 0)));
scene.add(Sphere(Vec3(-1, 0, -1), 0.5, Material(2, one(), 1.5)));
scene.add(Sphere(Vec3(1, 0, -1), 0.5, Material(1, Vec3(0.8, 0.6, 0.2), 0.2)));

akthe width: LekKut = 200;
akthe height: LekKut = 100;
akthe samples: LekKut = 8;
akthe max_depth: LekKut = 10;
akthe viewport_h = 2;
akthe viewport_w = viewport_h * LekThom(width) / LekThom(height);

jongyeytha "P3";
jongyeytha "200 100";
jongyeytha "255";
somhab (akthe j: LekKut = 0; j < height; j = j + 1) {
    somhab (akthe i: LekKut = 0; i < width; i = i + 1) {
        akthe color = zero();
        somhab (akthe s: LekKut = 0; s < samples; s = s + 1) {
            akthe u = (LekThom(i) + rng.uniform()) / LekThom(width);
            akthe v = (LekThom(j) + rng.uniform()) / LekThom(height);
            akthe dir = Vec3((u - 0.5) * viewport_w, (0.5 - v) * viewport_h, -1);
            color = color + ray_color(Ray(zero(), dir), scene, max_depth);
        }
        color = color / LekThom(samples);
        jongyeytha LekThom(to_byte(color.x));
        jongyeytha LekThom(to_byte(color.y));
        jongyeytha LekThom(to_byte(color.z));
    }
}
